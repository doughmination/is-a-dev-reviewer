{
  "extends": "$app/tsconfig",
  "include": ["src", "tests", "*"],
  "exclude": ["src/service-worker"],
  "compilerOptions": {
    // worker-configuration.d.ts imports the built Worker, so without this
    // svelte-check type-checks the whole compiled bundle after a build
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"]
  }
}
